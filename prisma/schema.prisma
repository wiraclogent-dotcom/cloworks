generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  REQUESTER
  CREATIVE
  LEAD
  ADMIN
}

enum JobRole {
  DESIGNER
  SOCIAL_MEDIA
  OTHER
}

enum RequestStatus {
  REQUESTED
  ON_PROGRESS
  FIRST_LOOK
  DONE
  CANCELLED
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  DONE
  ON_HOLD
}

// Every scoped model carries `workspaceId String @default(dbgenerated())`. The database has NO default (an insert
// without a workspace fails); the empty dbgenerated() only makes the field optional in Prisma's create types so
// the scoped client (src/lib/db.ts) can stamp it.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users             User[]
  allowedEmails     AllowedEmail[]
  brands            Brand[]
  divisions         Division[]
  requestTypes      RequestType[]
  requests          Request[]
  statusEvents      StatusEvent[]
  deadlineEvents    DeadlineEvent[]
  comments          Comment[]
  attachments       Attachment[]
  kpiTargets        KpiTarget[]
  notifications     Notification[]
  chatReads         ChatRead[]
  projects          Project[]
  projectTasks      ProjectTask[]
  projectMilestones ProjectMilestone[]
}

model User {
  id                 String    @id @default(cuid())
  email              String?   @unique
  name               String
  fullName           String
  title              String?
  department         String?
  appRole            AppRole   @default(REQUESTER)
  jobRole            JobRole   @default(OTHER)
  aliases            String[]
  active             Boolean   @default(true)
  /// scrypt hash for email + password sign-in; null = no password set.
  passwordHash       String?
  /// Bumped on every password change; sessions issued under an older version end.
  passwordVersion    Int       @default(0)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  /// Set when an admin sets or resets the password; cleared when the person changes it.
  mustChangePassword Boolean   @default(false)

  requested      Request[]       @relation("RequestRequester")
  assigned       Request[]       @relation("RequestAssignee")
  statusEvents   StatusEvent[]
  deadlineEvents DeadlineEvent[]
  comments       Comment[]
  attachments    Attachment[]
  kpiTargets     KpiTarget[]
  notifications  Notification[]
  chatReads      ChatRead[]
  ownedProjects  Project[]
  projectTasks   ProjectTask[]

  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
}

model AllowedEmail {
  id    String  @id @default(cuid())
  email String
  note  String?

  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

model Brand {
  id       String    @id @default(cuid())
  name     String
  requests Request[]
  projects Project[]

  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Division {
  id       String    @id @default(cuid())
  name     String
  requests Request[]

  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model RequestType {
  id          String    @id @default(cuid())
  name        String
  fieldSchema Json      @default("[]")
  active      Boolean   @default(true)
  requests    Request[]

  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Request {
  id               String        @id @default(cuid())
  title            String
  briefUrl         String?
  notes            String?
  brandId          String
  divisionId       String
  typeId           String
  requesterId      String
  assigneeId       String?
  requestedAt      DateTime      @default(now())
  deadline         DateTime?
  originalDeadline DateTime?
  status           RequestStatus @default(REQUESTED)
  outputCount      Int           @default(1)
  includeKpi       Boolean       @default(true)
  needsMotion      Boolean       @default(false)
  designFolderUrl  String?
  fields           Json          @default("{}")

  brand     Brand       @relation(fields: [brandId], references: [id])
  division  Division    @relation(fields: [divisionId], references: [id])
  type      RequestType @relation(fields: [typeId], references: [id])
  requester User        @relation("RequestRequester", fields: [requesterId], references: [id])
  assignee  User?       @relation("RequestAssignee", fields: [assigneeId], references: [id])

  statusEvents   StatusEvent[]
  deadlineEvents DeadlineEvent[]
  comments       Comment[]
  attachments    Attachment[]
  notifications  Notification[]
  chatReads      ChatRead[]

  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([status])
  @@index([assigneeId])
  @@index([requestedAt])
  @@index([workspaceId])
}

model StatusEvent {
  id        String         @id @default(cuid())
  requestId String
  from      RequestStatus?
  to        RequestStatus
  actorId   String
  at        DateTime       @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id])

  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([requestId])
  @@index([workspaceId])
}

model DeadlineEvent {
  id        String    @id @default(cuid())
  requestId String
  from      DateTime?
  to        DateTime
  actorId   String
  at        DateTime  @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id])

  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([requestId])
  @@index([workspaceId])
}

model Comment {
  id        String   @id @default(cuid())
  requestId String
  authorId  String
  body      String
  mentions  String[]
  createdAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([requestId])
  @@index([requestId, createdAt])
  @@index([workspaceId])
}

model ChatRead {
  id         String   @id @default(cuid())
  userId     String
  requestId  String
  lastReadAt DateTime

  user    User    @relation(fields: [userId], references: [id])
  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, requestId])
  @@index([workspaceId])
}

model Attachment {
  id         String   @id @default(cuid())
  requestId  String
  uploaderId String
  name       String
  url        String
  mimeType   String?
  sizeBytes  Int?
  createdAt  DateTime @default(now())

  request  Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaderId], references: [id])

  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([requestId])
  @@index([workspaceId])
}

model KpiTarget {
  id          String  @id @default(cuid())
  userId      String
  month       String
  role        JobRole
  targetTasks Int
  note        String?

  user User @relation(fields: [userId], references: [id])

  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, month])
  @@index([workspaceId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  requestId String?
  type      String
  message   String
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id])
  request Request? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([userId, readAt])
  @@index([workspaceId])
}

enum ProjectStage {
  NOT_STARTED
  FIRST_PREVIEW
  MANUSCRIPT
  TECHNICAL_ARTWORK
  APPROVAL
  FINAL_ARTWORK
  CANCELLED
}

model Project {
  id        String        @id @default(cuid())
  code      String?
  title     String
  subTitle  String?
  brandId   String?
  ownerId   String
  status    ProjectStatus @default(NOT_STARTED)
  startDate DateTime?
  dueDate   DateTime?
  fileUrl   String?

  brand      Brand?             @relation(fields: [brandId], references: [id])
  owner      User               @relation(fields: [ownerId], references: [id])
  tasks      ProjectTask[]
  milestones ProjectMilestone[]

  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, code])
  @@index([workspaceId])
}

/// One row of a design project sheet: a product (title) and its variant (subTitle). Grouped by title.
model ProjectTask {
  id        String         @id @default(cuid())
  projectId String
  position  Int
  title     String
  subTitle  String?
  ownerId   String?
  stage     ProjectStage?
  status    ProjectStatus?
  startDate DateTime?
  dueDate   DateTime?
  /// Sheet says TBC for the due date; `dueDate` stays null.
  dueTbc    Boolean        @default(false)
  fileName  String?
  fileUrl   String?
  notes     String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?   @relation(fields: [ownerId], references: [id])

  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([projectId, position])
  @@index([workspaceId])
}

model ProjectMilestone {
  id        String   @id @default(cuid())
  projectId String
  title     String
  date      DateTime
  done      Boolean  @default(false)
  notes     String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  workspaceId String    @default(dbgenerated())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([projectId, date])
  @@index([workspaceId])
}

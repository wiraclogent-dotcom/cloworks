{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "db",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "db:dev"
      ],
      "port": 54329,
      "autoPort": false
    },
    {
      "name": "db-54330",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PGPORT=54330",
        "npm",
        "run",
        "db:dev"
      ],
      "port": 54330,
      "autoPort": false
    },
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "app-nomail",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "RESEND_API_KEY=",
        "EMAIL_FROM=",
        "npm",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "app-3001",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AUTH_URL=http://localhost:3001",
        "APP_BASE_URL=http://localhost:3001",
        "DATABASE_URL=postgresql://postgres:postgres@localhost:54330/creative_tracker",
        "npm",
        "run",
        "dev",
        "--",
        "-p",
        "3001"
      ],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "app-3002",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AUTH_URL=http://localhost:3002",
        "APP_BASE_URL=http://localhost:3002",
        "npm",
        "run",
        "dev",
        "--",
        "-p",
        "3002"
      ],
      "port": 3002,
      "autoPort": false
    }
  ]
}

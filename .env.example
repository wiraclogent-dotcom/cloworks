# Run `npm run db:dev` to start a local embedded Postgres; it prints this URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/creative_tracker"
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
# Auth.js (placeholders only; never commit real values)
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
AUTH_MICROSOFT_ENTRA_ID_ID="your-entra-app-client-id"
AUTH_MICROSOFT_ENTRA_ID_SECRET="your-entra-app-client-secret"
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
# Required: Entra sign-in is denied unless the token tid matches this tenant id
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID="<tenant-id>"
# Email notifications via Resend (optional; sending is skipped when unset)
RESEND_API_KEY=""
EMAIL_FROM="Cloworks <noreply@example.com>"
# Used to build links in emails, e.g. https://tracker.example.com
APP_BASE_URL="http://localhost:3000"
# Cloudinary media uploads for Content Plan (optional; uploads are disabled when unset).
# Create a free Cloudinary account; the three values are on the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# e2e tests only (optional): a local account the browser tests sign in with, and a model for tests/e2e/agent
LOCAL_QA_EMAIL=""
LOCAL_QA_PASSWORD=""
ANTHROPIC_API_KEY=""
